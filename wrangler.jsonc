{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "islandcart-weekly-flyer-sync",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-27",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
		"binding": "USER_NOTIFICATION",
		"id": "876f1c2733c4449dba2895c3e3fda95e"
		}
	]
}
